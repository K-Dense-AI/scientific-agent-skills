{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api/index.py",
      "bindings": [
        {
          "type": "service",
          "service": "assets",
          "format": "url",
          "env": "ASSETS_URL"
        },
        {
          "type": "service",
          "service": "assets-2",
          "format": "url",
          "env": "ASSETS_2_URL"
        }
      ]
    },
    "assets": {
      "root": "skills/13c-metabolic-flux/assets",
      "runtime": "python",
      "entrypoint": "api/index.py"
    },
    "assets-2": {
      "root": "skills/primer-design/assets",
      "runtime": "python",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
